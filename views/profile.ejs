<!doctype html>
<html lang="en">
<head>
  <meta charset="UTF-8">
  <meta name="viewport" content="width=device-width, initial-scale=1">
  <title>Profile Athlete</title>
 <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
  <link rel="stylesheet" href="profile.css">
</head>
<body>
  <input type="checkbox" id="sidebar-toggle" class="peer sr-only">
  <header class="sticky top-0 z-40 flex h-16 items-center justify-between border-b border-gray-200 bg-white px-4">
    <div class="flex items-center gap-3">
      <label for="sidebar-toggle" class="cursor-pointer rounded-lg p-2 text-gray-700 hover:bg-gray-100 lg:hidden" aria-label="Open menu">
        <span class="fa-solid fa-bars"></span>
      </label>
      <a href="/" class="logo-title items-center">
       <img class="img-logo h-16 w-auto" src="img/liftflow.png" alt="litflow logo">                    
      </a>
    </div>

    <div class="hidden items-center gap-4 lg:flex">
      <span class="text-sm text-gray-500">Welcome! <span class="font-semibold text-gray-900"><%= user.name %></span></span>
      <a href="/logout" class="rounded-lg px-3 py-2 text-sm font-medium text-gray-700 hover:bg-gray-100 hover:text-gray-900">Logout</a>
    </div>
     <!--mobile-->
      <input type="checkbox" id="menu-toggle" class="peer sr-only">
      <label for="menu-toggle" class="lg:hidden cursor-pointer rounded-lg p-2 text-gray-700 hover:bg-gray-100 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500" aria-label="Toggle menu">
        <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
        <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
        </svg>
      </label>

      <!-- Menú móvil: se muestra cuando el checkbox está marcado -->
      <div class="hidden peer-checked:flex md:hidden absolute left-0 right-0 top-full flex-col border-t border-gray-200 bg-white p-2 shadow-md">
        <h2>Welcome!<strong><%= user.name %></strong></h2>
        <a href="/profile" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Profile</a>
      </div>
  </header>
  <main class="container">  
    <div class="min-h-screen lg:flex">
      <input type="checkbox" id="sidebar-toggle" class="peer sr-only">

       <%- include('sidebar', { name: user.name }) %>

      <!-- Fondo oscuro: toca para cerrar (solo móvil) -->
     <label for="sidebar-toggle" class="fixed inset-x-0 bottom-0 top-16 z-20 hidden bg-black/40 peer-checked:block lg:hidden"></label>

      <div class="flex-1">
        <!-- Barra superior móvil -->
        <div class="flex items-center border-b border-gray-200 p-3 lg:hidden">
          <label for="sidebar-toggle" class="cursor-pointer rounded-lg p-2 text-gray-700 hover:bg-gray-100" aria-label="Open menu">
            <span class="fa-solid fa-bars"></span>
          </label>
        </div>

        <main class="p-6">
          <!-- contenido de la página -->
        </main>
      </div>
    </div>
    
   <section class="container-principal"> 

    <nav class="border-b border-gray-200 bg-white">
  <div class="mx-auto flex max-w-6xl items-center gap-1 px-4">
    <!-- Pestaña activa (sin desplegable) -->
    <a href="/guides" aria-current="page"
       class="-mb-px flex items-center gap-2 border-b-2 border-violet-900 px-3 py-3 text-sm font-semibold text-gray-900">
      <span class="fa-regular fa-file-lines"></span> Guides
    </a>

    <!-- Pestaña con desplegable -->
    <div class="group relative">
      <button type="button"
              class="-mb-px flex items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-medium text-gray-700 hover:text-gray-900 group-hover:text-gray-900 group-focus-within:text-gray-900">
        <span class="fa-solid fa-wrench"></span>
        Libraries and tools
        <span class="fa-solid fa-chevron-down text-xs text-gray-400 transition-transform group-hover:rotate-180 group-focus-within:rotate-180"></span>
      </button>

      <!-- Menú: aparece con hover o con foco de teclado -->
      <div class="invisible absolute left-0 top-full z-20 w-56 pt-1 opacity-0 transition group-hover:visible group-hover:opacity-100 group-focus-within:visible group-focus-within:opacity-100">
        <div class="rounded-xl border border-gray-200 bg-white p-2 shadow-lg">
          <a href="#" class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900">API clients</a>
          <a href="#" class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900">CLI</a>
          <a href="#" class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900">Wizard</a>
          <a href="#" class="block rounded-lg px-3 py-2 text-sm text-gray-700 hover:bg-gray-100 hover:text-gray-900">Crawler</a>
        </div>
      </div>
    </div>

    <!-- Otra pestaña con desplegable: copia el bloque anterior -->
    <a href="/api" class="-mb-px flex items-center gap-2 border-b-2 border-transparent px-3 py-3 text-sm font-medium text-gray-700 hover:text-gray-900">
      <span class="fa-solid fa-code"></span> API reference
    </a>
  </div>
</nav>
      <!-- ========== TABS (horizontal nav) ========== -->
      <nav class="border-b border-gray-200 bg-white">
        <ul class="mx-auto flex max-w-6xl items-center gap-1 px-4" id="pills-tab" role="tablist">
          <li class="nav-item" role="presentation">
            <button class="nav-link active" id="tab-account" data-bs-toggle="tab" data-bs-target="#pills-home" type="button" role="tab" aria-controls="pills-home" aria-selected="true">Account and Profile</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-discipline" data-bs-toggle="tab" data-bs-target="#pills-profile" type="button" role="tab" aria-controls="pills-profile" aria-selected="false">Discipline and Experience</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-goals" data-bs-toggle="tab" data-bs-target="#pills-contact" type="button" role="tab" aria-controls="pills-contact" aria-selected="false">Goals</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-availability-environment" data-bs-toggle="tab" data-bs-target="#pills-contact" type="button" role="tab" aria-controls="pills-contact" aria-selected="false">Availability and environment</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-starting-point" data-bs-toggle="tab" data-bs-target="#pills-contact" type="button" role="tab" aria-controls="pills-contact" aria-selected="false">Starting point</button>
          </li>
          <li class="nav-item" role="presentation">
            <button class="nav-link" id="tab-nutrition" data-bs-toggle="tab" data-bs-target="#pills-contact" type="button" role="tab" aria-controls="pills-contact" aria-selected="false">Nutrition</button>
          </li>
        </ul>

        <div class="tab-content" id="pills-tabContent">

          <!-- HOME: welcome + form side by side -->
          <div class="tab-pane show active" id="pills-home" role="tabpanel" aria-labelledby="pills-home-tab" tabindex="0">
            <div class="welcome-layout">
              <!-- Form (information this one for height / weight) -->
              <div class="tab-pane show active" id="pane-account" role="tabpanel" aria-labelledby="tab-account" tabindex="0">
                <h3>Let's get started</h3>
                <% if (user.local.email) { %>
                 <form class="formulario" data-section="account">
                    <input type="text" value="<%= user.local.email %>" disabled class="input-menu">

                    <label for="role">How are you going to use LiftFlow?</label>
                    <select name="role" id="role" class="input-menu" required>
                      <option value="">Please choose an option</option>
                      <option value="Athlete">Athlete</option>
                      <option value="Coach">Coach</option>
                      <option value="Both">Both</option>
                    </select>
                    <small class="field-error" data-error-for="role"></small>

                    <label for="language">Language</label>
                    <select name="language" id="language" class="input-menu" required>
                      <option value="">Please choose an option</option>
                      <option value="English">English</option>
                      <option value="Spanish">Spanish</option>
                    </select>
                    <small class="field-error" data-error-for="language"></small>

                    <label for="unitSystem">Unit System</label>
                    <select name="unitSystem" id="unitSystem" class="input-menu" required>
                      <option value="">Please choose an option</option>
                      <option value="Metric">Metric</option>
                      <option value="Imperial">Imperial</option>
                    </select>
                    <small class="field-error" data-error-for="unitSystem"></small>

                    <button type="submit" class="btn-primary">Save and continue</button>
                  </form>
                <% } %>
              </div>

            </div>
          </div>

          <!-- PROFILE -->
          <div class="tab-pane" id="pills-profile" role="tabpanel" aria-labelledby="pills-profile-tab" tabindex="0">
            <p>This is some placeholder content the <strong>Profile tab’s</strong> associated content.</p>
          </div>

          <!-- CONTACT -->
          <div class="tab-pane" id="pills-contact" role="tabpanel" aria-labelledby="pills-contact-tab" tabindex="0">
            <p>This is some placeholder content the <strong>Contact tab’s</strong> associated content.</p>
          </div>

        </div>
      </nav>

      <!-- ========== MENU TABLE ========== -->
      <section class="table-wrapper">
        <table>
          <tr class="table-headings">
            <th>Category</th>
            <th>Title</th>
            <th>Description</th>
            <th>Price</th>
            <th>Actions</th>
          </tr>
            <tr class="table-body">
              <td colspan="5">There is no info right now =(</td>
            </tr>
          
        </table>
      </section>

      
    <section>
  </main>

  <!-- ========== SCRIPTS ========== -->
  <script type="module" src="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/js/bootstrap.bundle.min.js" integrity="sha384-1a/pXj49ZQ1aHEmrJ+gMw1otqoVsYwlEnlD8mIfY2TV03r20Y0CN7uqx1tQogjPL" crossorigin="anonymous"></script>
  <script src="main.js"></script>
</body>
</html>
