<!doctype html>
<html>
<head>
    <title>liftflow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo-title">
                <img class="img-logo" src="img/liftflow.png" alt="logo litflow">                    
            </div>
            <ul class="nav justify-content-end">
                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">How it Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">FAQs</a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/signup">Get Started</a>
                </li>
            </ul>
        </nav>
    </header>
    <section class="container-onbording">
        <section class="container-panel">

        </section>
        <section class="container-signup">
                <h1><span class="fa fa-sign-in"></span> Glad you are here</h1>
                <% if (message.length > 0) { %>
                    <div class="alert alert-danger"><%= message %></div>
                <% } %>
                <!-- LOGIN FORM -->
                <form action="/signup" method="post">
                    <div class="form-field">
                        <label  for="name" class="form-label">Name</label>
                        <input type="text" class="form-control" name="name" id="name">
                    </div>
                    <div class="form-field">
                        <label for="email" class="form-label">Email</label>
                        <input type="email" class="form-control" id="email" placeholder="name@example.com">
                    </div>
                    <div class="form-field">
                       <label for="passsignup" class="form-label">Password</label>
                            <input type="password" id="passsignup" class="form-control" aria-describedby="passwordHelpBlock">
                            <div id="passwordHelpBlock" class="form-text">
                                Your password must be 8-20 characters long, contain letters and numbers, and must not contain spaces, special characters, or emoji.
                            </div>
                    </div>
                    <div class="container-btn-signup">
                        <button type="submit" class="btn btn-primary btn-lg">Signup</button>
                    </div>
                </form>
                <p>Or</p>
                <div class="container-btn-signup">
                    <button type="submit" class="btn btn-secondary btn-lg">Continue with Google</button>
                </div>
                <p>Or go <a href="/">home</a>.</p>
                <p>Already have an account? <a href="/login">Login</a></p>
                
        </section>
    </section>
</body>
</html>
