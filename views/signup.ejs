<!doctype html>
<html>
<head>
    <title>liftflow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
   <header class="relative border-b border-gray-200">
        <nav class="flex justify-around items-center p-4">
            <a href="/" class="logo-title items-center">
                <img class="img-logo h-16 w-auto" src="img/liftflow.png" alt="litflow logo">                    
            </a>
            <div class="hidden md:flex items-center">
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    About
                </a>
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    How it Works
                </a>
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                   FAQs
                </a>
                <a href="/login" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    Login
                </a>
                <a href="/signup" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    Get Started
                </a>
            </div>
            <!--mobile-->
            <input type="checkbox" id="menu-toggle" class="peer sr-only">
            <label for="menu-toggle" class="md:hidden cursor-pointer rounded-lg p-2 text-gray-700 hover:bg-gray-100 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500" aria-label="Toggle menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            </label>

            <!-- Menú móvil: se muestra cuando el checkbox está marcado -->
            <div class="hidden peer-checked:flex md:hidden absolute left-0 right-0 top-full flex-col border-t border-gray-200 bg-white p-2 shadow-md">
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">About</a>
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">How it Works</a>
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">FAQs</a>
            <a href="/login" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Login</a>
            <a href="/signup" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Get Started</a>
            </div>
        </nav>
    </header>
     <main class="grid min-h-[calc(80vh-6rem)] grid-cols-1 lg:grid-cols-2">
        <section class="container-panel flex min-h-96 max-h-screen flex-col justify-end px-4 py-8 text-center md:py-16">
            <span class="text-sm font-semibold tracking-widest text-violet-200">BECOME YOUR STRONGEST SELF</span>
            <h1 class="mt-3 text-3xl font-bold text-white md:text-5xl">Progress feels better with a plan.</h1>
        </section>
        <!--Login-->
        <section class="flex flex-col justify-center px-6 py-10 md:px-12">
            <div class="mx-auto w-full max-w-md">
                <h1 class="flex items-center gap-2 text-3xl font-bold text-gray-900">
                    <span class="fa fa-sign-in text-violet-900"></span> Glad you are here
                </h1>
                <% if (message.length > 0) { %>
                <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                    <%= message %>
                </div>
                <% } %>
                <!-- Login Form -->
                <form action="/signup" method="POST" class="mt-6 flex flex-col gap-4">
                     <div>
                        <label for="name" class="mb-1 block text-sm font-medium text-gray-700">Full name</label>
                        <input type="name" id="email" name="name" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-violet-900 focus:outline-none focus:ring-2 focus:ring-violet-900/30">
                    </div>
                    <div>
                        <label for="email" class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                        <input type="email" id="email" name="email" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-violet-900 focus:outline-none focus:ring-2 focus:ring-violet-900/30">
                    </div>
                    <div>
                        <label for="password" class="mb-1 block text-sm font-medium text-gray-700">Password</label>
                        <input type="password" id="password" name="password" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-violet-900 focus:outline-none focus:ring-2 focus:ring-violet-900/30">
                    </div>
                    <button type="submit" class="w-full rounded-lg bg-violet-900 px-4 py-2 font-medium text-white hover:bg-violet-950">
                        Signup
                    </button>
                </form>
                <hr class="my-6 border-gray-200">
                <p class="text-sm text-gray-600">
                    Need an account?
                    <a href="/signup" class="font-medium text-violet-900 hover:underline">Signup</a>
                </p>
                <p class="mt-1 text-sm text-gray-600">
                    Or go 
                    <a href="/" class="font-medium text-violet-900 hover:underline">home</a>.
                </p>
            </div>
        </section>
    </main>
    <footer class="flex flex-col items-center gap-4 border-t border-gray-200 px-4 py-6 md:flex-row md:justify-around md:px-8">
        <p class="text-sm text-gray-500 justify-center">© 2026 LiftFlow Privacy Terms</p>
        <img src="img/liftflow.png" alt="logo lift flow " class="img-footer">
    </footer>
</body>
</html>
