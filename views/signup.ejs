<!doctype html>
<html>
<head>
    <title>liftflow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
   <%- include('partials/header.ejs') %>
     <main class="grid min-h-[calc(80vh-6rem)] grid-cols-1 lg:grid-cols-2">
        <section class="container-panel flex min-h-96 max-h-screen flex-col justify-end px-4 py-8 text-center md:py-16">
            <span class="text-sm font-semibold tracking-widest text-violet-200">BECOME YOUR STRONGEST SELF</span>
            <h1 class="mt-3 text-3xl font-bold text-white md:text-5xl">Progress feels better with a plan.</h1>
        </section>
        <!--Login-->
        <section class="flex flex-col justify-center px-6 py-10 md:px-12">
            <div class="mx-auto w-full max-w-md">
                <h1 class="flex items-center gap-2 text-3xl font-bold text-gray-900">
                    <span class="fa fa-sign-in text-violet-900"></span> Glad you are here
                </h1>
                <% if (message.length > 0) { %>
                <div class="mt-4 rounded-lg border border-red-200 bg-red-50 px-4 py-3 text-sm text-red-700" role="alert">
                    <%= message %>
                </div>
                <% } %>
                <!-- Login Form -->
                <form action="/signup" method="POST" class="mt-6 flex flex-col gap-4">
                     <div>
                        <label for="name" class="mb-1 block text-sm font-medium text-gray-700">Full name</label>
                        <input type="name" id="email" name="name" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-red-900 focus:outline-none focus:ring-2 focus:ring-red-900/30">
                    </div>
                    <div>
                        <label for="email" class="mb-1 block text-sm font-medium text-gray-700">Email</label>
                        <input type="email" id="email" name="email" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-red-900 focus:outline-none focus:ring-2 focus:ring-red-900/30">
                    </div>
                    <div>
                        <label for="password" class="mb-1 block text-sm font-medium text-gray-700">Password</label>
                        <input type="password" id="password" name="password" required class="w-full rounded-lg border border-gray-300 px-3 py-2 text-gray-900 focus:border-red-900 focus:outline-none focus:ring-2 focus:ring-red-900/30">
                    </div>
                    <button type="submit" class="w-full rounded-lg bg-red-700 px-4 py-2 font-medium text-white hover:bg-red-800">
                        Signup
                    </button>
                </form>
                <hr class="my-6 border-gray-200">
                <div class="text-center">
                    <p class="text-sm text-gray-600">
                        Need an account?
                        <a href="/signup" class="font-medium text-blue-600 hover:underline">Signup</a>
                    </p>
                    <p class="mt-1 text-sm text-gray-600">
                        Or go 
                        <a href="/" class="font-medium text-blue-600 hover:underline">home</a>.
                    </p>
                <div>
            </div>
        </section>
    </main>
    
   <%- include('partials/footer.ejs') %>
</body>
</html>
