
   <%- include('partials/header.ejs') %>
    <main class="grid grid-cols-1 lg:grid-cols-2">
        <section class="mx-auto max-w-3xl px-4 py-10 text-center md:py-16">
            <span class="text-sm font-semibold tracking-widest text-red-700">STRONGER, TOGETHER</span>
            <h1 class="mt-3 text-3xl font-bold text-gray-900 md:text-5xl">Your goals. Your pace. A stronger you.</h1>
            <p class="mt-4 text-base text-gray-600 md:text-lg">Plan your training, manage your nutrition, and track your progress—on your own or with a coach.</p>
            <h3 class="mt-8 text-xl font-semibold text-gray-900">Start your journey</h3>
            <h3 class="mt-2 text-base font-medium text-gray-500">Your progress stays with you</h3>   
        </section>

        <section class="mt-6 block gap-6 md:grid-cols-2 sm:grid-cols-1">
            <span class="text-lg font-semibold text-gray-900">How will you use LiftFlow?</span>

            <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2 sm:grid-cols-1">
                <!--card athlete-->
                <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-4 text-left shadow-sm">
                    <img src="/img/athlete.jpg" class="h-48 w-full rounded-xl object-cover" alt="athlete picture">
                    <h5 class="mt-3 text-lg font-semibold text-gray-900">I'm an athlete</h5>
                    <p class="mt-1 text-gray-600">Train with purpose. Fuel your goals. Find support to become your strongest self.</p>
                        
                    <a href="/signup"class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg bg-red-700 px-4 py-2 font-medium text-white hover:bg-red-800">
                        Athlete
                        <span class="fa-solid fa-arrow-right"></span>
                    </a>
                    <small class="mt-2 text-gray-500">Your coach. Your plan. Your pace.</small>
                </div>
                <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-4 shadow-sm justify-center">
                   <img src="/img/coach.jpg" class="h-48 w-full rounded-xl object-cover" alt="athlete picture">
                    <h5 class="mt-3 text-lg font-semibold text-gray-900">I'm a coach</h5>
                    <p class="mt-1 text-gray-600">Build your practice. Guide your athletes. Make every day count.</p>
                    <a href="/signup" class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg bg-red-700 px-4 py-2 font-medium text-white hover:bg-red-800">
                        Coach 
                    <span class="fa-solid fa-arrow-right"></span>
                    </a>
                    <small class="mt-2 text-gray-500">More coaching. Less admin.</small>
                </div>
            </section>
            <p class="mt-8 text-gray-600 text-center">Already part of the community? 
                <a href="/login" class="font-medium text-blue-600 hover:underline">
                    Log in →
                </a>
            </p>
        </section>
    </main>
  <%- include('partials/footer.ejs') %>

