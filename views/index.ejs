<!doctype html>
<html>
<head>
    <title>liftflow</title>
    <meta name="viewport" content="width=device-width, initial-scale=1">
    <link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">
    <link rel="stylesheet" href="font-awesome.min.css">
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header>
        <nav>
            <div class="logo-title">
                <img class="img-logo" src="img/liftflow.png" alt="logo litflow">                    
            </div>
            <ul class="nav justify-content-end">
                <li class="nav-item">
                    <a class="nav-link active" aria-current="page" href="/">About</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">How it Works</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="#">FAQs</a>
                </li>
                 <li class="nav-item">
                    <a class="nav-link" href="/login">Login</a>
                </li>
                <li class="nav-item">
                    <a class="nav-link" href="/signup">Get Started</a>
                </li>
            </ul>
        </nav>
    </header>
    <main>
        <section class="container-introduction">
            <span>STRONGER, TOGETHER</span>
            <h1 >Your goals. Your pace. A stronger you.</h1>
            <p>Plan your training, manage your nutrition, and track your progress—on your own or with a coach.</p>
            <h3>Start your journey</h3>
            <h3>Your progress stays with you</h3>   
        </section>
        <section class="container-roles">
            <span>How will you use LiftFlow?</span>
            <section class="container-roles-cards">
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <img src="/img/athlete.jpg" class="card-img" alt="...">
                        <h5 class="mt-2 mb-0">I’m an athlete</h5>
                        <p class="card-text fg-2">Train with purpose. Fuel your goals. Find support to become your strongest self.</p>
                        
                        <a href="/signup" class="btn-primary btn-solid btn-styled">Signup
                            <span class="fa-solid fa-arrow-right"></span>
                        </a>
                        <small class="fg-3">Your coach. Your plan. Your pace.</small>
                    </div>
                </div>
                <div class="card" style="width: 18rem;">
                    <div class="card-body">
                        <img src="/img/coach.jpg" class="card-img" alt="...">
                        <h5 class="mt-2 mb-0">I’m an coach</h5>
                        <p class="card-text fg-2">Build your practice. Guide your athletes. Make every day count.</p>
                        
                        <a href="/signup" class=" btn-primary btn-styled">Signup<span class="fa-solid fa-arrow-right"></span>
                        </a>
                        <small class="fg-3">More coaching. Less admin.</small>
                    </div>
                </div>
            </section>
            <span class="community">Already part of the community? <a href="/login">Log in →</a></span>
        </section>
    </main>
    <footer>
        <section class="footer-info">
            <p>© 2026 LiftFlow Privacy Terms</p>
        </section>
        <section class="footer-info">
             <img src="img/liftflow.png" alt="logo lift flow " class="img-footer">
        </section>

    </footer>
</body>
</html>
