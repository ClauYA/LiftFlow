<!doctype html>
<html>
<head>
    <title>liftflow</title>
    <!--<link href="https://cdn.jsdelivr.net/npm/bootstrap@6.0.0-alpha.1/dist/css/bootstrap.min.css" rel="stylesheet" integrity="sha384-B/GM4XqrwHnWXNOWMbloTmrYXZg10cakYGmpfsR/bbzQ6JAJI4ihuyADKLnBgrCe" crossorigin="anonymous">-->
    <meta name="viewport" content="width=device-width, initial-scale=1.0" />
    <script src="https://cdn.jsdelivr.net/npm/@tailwindcss/browser@4"></script>
    <link rel="stylesheet" href="style.css">
</head>
<body>
    <header class="relative border-b border-gray-200">
        <nav class="flex justify-around items-center p-4">
             <a href="/" class="logo-title items-center">
                <img class="img-logo h-16 w-auto" src="img/liftflow.png" alt="litflow logo">                    
             </a>
            <div class="hidden md:flex items-center">
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    About
                </a>
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    How it Works
                </a>
                <a href="/" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                   FAQs
                </a>
                <a href="/login" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    Login
                </a>
                <a href="/signup" class="font-medium rounded-lg px-3 py-2 text-gray-700 hover:bg-violet-200 hover:text-gray-900">
                    Get Started
                </a>
            </div>
            <!--mobile-->
            <input type="checkbox" id="menu-toggle" class="peer sr-only">
            <label for="menu-toggle" class="md:hidden cursor-pointer rounded-lg p-2 text-gray-700 hover:bg-gray-100 peer-focus-visible:ring-2 peer-focus-visible:ring-blue-500" aria-label="Toggle menu">
            <svg class="h-6 w-6" fill="none" stroke="currentColor" stroke-width="2" viewBox="0 0 24 24">
                <path stroke-linecap="round" stroke-linejoin="round" d="M4 6h16M4 12h16M4 18h16" />
            </svg>
            </label>

            <!-- Menú móvil: se muestra cuando el checkbox está marcado -->
            <div class="hidden peer-checked:flex md:hidden absolute left-0 right-0 top-full flex-col border-t border-gray-200 bg-white p-2 shadow-md">
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">About</a>
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">How it Works</a>
            <a href="/" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">FAQs</a>
            <a href="/login" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Login</a>
            <a href="/signup" class="block rounded-lg px-3 py-2 font-medium text-gray-700 hover:bg-gray-100">Get Started</a>
            </div>
        </nav>
    </header>
    <main class="grid grid-cols-1 lg:grid-cols-2">
        <section class="mx-auto max-w-3xl px-4 py-10 text-center md:py-16">
            <span class="text-sm font-semibold tracking-widest text-violet-800">STRONGER, TOGETHER</span>
            <h1 class="mt-3 text-3xl font-bold text-gray-900 md:text-5xl">Your goals. Your pace. A stronger you.</h1>
            <p class="mt-4 text-base text-gray-600 md:text-lg">Plan your training, manage your nutrition, and track your progress—on your own or with a coach.</p>
            <h3 class="mt-8 text-xl font-semibold text-gray-900">Start your journey</h3>
            <h3 class="mt-2 text-base font-medium text-gray-500">Your progress stays with you</h3>   
        </section>

        <section class="mt-6 block gap-6 md:grid-cols-2 sm:grid-cols-1">
            <span class="text-lg font-semibold text-gray-900">How will you use LiftFlow?</span>

            <section class="mt-6 grid grid-cols-1 gap-6 lg:grid-cols-2 sm:grid-cols-1">
                <!--card athlete-->
                <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-4 text-left shadow-sm">
                    <img src="/img/athlete.jpg" class="h-48 w-full rounded-xl object-cover" alt="athlete picture">
                    <h5 class="mt-3 text-lg font-semibold text-gray-900">I'm an athlete</h5>
                    <p class="mt-1 text-gray-600">Train with purpose. Fuel your goals. Find support to become your strongest self.</p>
                        
                    <a href="/signup"class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg bg-violet-900 px-4 py-2 font-medium text-white hover:bg-violet-950">
                        Athlete
                        <span class="fa-solid fa-arrow-right"></span>
                    </a>
                    <small class="mt-2 text-gray-500">Your coach. Your plan. Your pace.</small>
                </div>
                <div class="flex flex-col rounded-2xl border border-gray-200 bg-white p-4 shadow-sm justify-center">
                   <img src="/img/coach.jpg" class="h-48 w-full rounded-xl object-cover" alt="athlete picture">
                    <h5 class="mt-3 text-lg font-semibold text-gray-900">I'm a coach</h5>
                    <p class="mt-1 text-gray-600">Build your practice. Guide your athletes. Make every day count.</p>
                    <a href="/signup" class="mt-4 flex w-full items-center justify-center gap-2 rounded-lg bg-violet-900 px-4 py-2 font-medium text-white hover:bg-violet-950">
                        Coach 
                    <span class="fa-solid fa-arrow-right"></span>
                    </a>
                    <small class="mt-2 text-gray-500">More coaching. Less admin.</small>
                </div>
            </section>
            <p class="mt-8 text-gray-600">Already part of the community? 
                <a href="/login" class="font-medium text-blue-600 hover:underline">
                    Log in →
                </a>
            </p>
        </section>
    </main>
    <footer class="flex flex-col items-center gap-4 border-t border-gray-200 px-4 py-6 md:flex-row md:justify-around md:px-8">
        <p class="text-sm text-gray-500 justify-center">© 2026 LiftFlow Privacy Terms</p>
        <img src="img/liftflow.png" alt="logo lift flow " class="img-footer">
    </footer>
</body>
</html>
